#!/bin/bash

user_id=$(id -u)
logs_file=/var/log/shell/shellscripting
logs_folder=${logs_file/${0}.log}

validate () {
    if [ $user_id -ne 0 ]; then
    echo "$user_id having sudo access"
    exit 1

fi
}

cp rabitmq.repo /etc/yum.repos.d/rabbitmq.repo
validate $? "Adding rabitmq repo"

dnf install erlang rabbitmq-server -y
validate $? "install rabiitmq server"

systemctl enable rabbitmq-server
systemctl start rabbitmq-server

validate $? "enable and start rabbit"

rabbitmqctl list_users | grep -qw "roboshop"

if [ $? -ne 0 ]; then

    rabbitmqctl add_user roboshop roboshop123 &>> $logs_file
    validate $? "Creating RabbitMQ user for Roboshop"    

    fi

rabbitmqctl set_permissions -p / roboshop ".*" ".*" ".*"

validate $? "set the permissions"

