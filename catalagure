#!/bin/bash
user_id=(id -u)
logs_file=/var/log/shellscripting
logs_folder="${logs_folder}/${0}.log"

mkdir -p $logs_folder

validate (){
    if [ $user_id -ne 0 ]; then
    echo "$user_id need to exit if user having sudo access"
    exit 1
    fi
}

dnf module disable nodejs -y
dnf module enable nodejs:24 -y
dnf install nodejs -y

validate $? "need to disable nodejs and install nodejs"

node -v
validate $? "validate node"

useradd --system --home /app --shell /sbin/nologin --comment "roboshop system user" roboshop
validate $? "create user and passsword"



mkdir /app
validate $? "create directory app"

curl -L -o /tmp/catalogue.zip https://raw.githubusercontent.com/daws-92s/roboshop-documentation/refs/heads/main/artifacts/catalogue-v4.zip
validate $? "zip the file and artifacts"

cd /app
validate $? "comeout the directory"

unzip /tmp/catalogue.zip
validate $? "unzip the file"

cd /app
validate $? "switch to app"

npm install
validate $? "install dependecies"

sed -i "s/DOMAIN_NAME/$domain_name/g" "$scripts_dir/catalogue.service"
cp "$scripts_dir/catalogue.service" /etc/systemd/system/catalogue.service


systemctl daemon-reload &>> $logs_file
systemctl enable catalogue &>> $logs_file
systemctl start catalogue &>> $logs_file
validate $? "Starting and enabling catalogue"

cp "$scripts_dir/mongo.repo" /etc/yum.repos.d/mongo.repo
validate $? "Adding Mongo repo"

dnf install mongodb-mongosh -y &>> $logs_file
validate $? "Installing MongoDB Client"

product_count=$(mongosh --host "mongodb.$domain_name" --quiet --eval 'db.getSiblingDB("catalogue").products.countDocuments()' 2>> $logs_file)
validate $? "Connecting to MongoDB"

if [ "$product_count" -eq 0 ]; then
    mongosh --host "mongodb.$domain_name" </app/db/master-data.js &>> $logs_file
    validate $? "Loading products"
else
    echo -e "$(timestamp) [INFO] Products are already loaded...${Y}SKIPPING${N}"
fi

systemctl restart catalogue
validate $? "Restarting Catalogue"